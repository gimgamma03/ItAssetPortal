@model ItAssetPortal.Models.Asset
@{
    ViewData["Title"] = "자산 등록";
}

<h1 class="h3 mb-3">자산 등록</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">자산 이름</label>
        <input asp-for="Name" class="form-control" placeholder="예: 노트북" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber" class="form-label">시리얼 번호 (선택)</label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">저장</button>
    <a class="btn btn-outline-secondary" asp-action="Index">목록</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}