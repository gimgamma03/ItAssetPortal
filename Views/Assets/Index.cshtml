@model IEnumerable<ItAssetPortal.Models.Asset>
@{
    ViewData["Title"] = "IT 자산 목록";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">IT 자산 목록</h1>
    <a class="btn btn-primary" asp-action="Create">자산 등록</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input
            type="text"
            name="q"
            class="form-control"
            placeholder="이름/시리얼 검색"
            value="@ViewBag.Query" />
    </div>
    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="latest" selected="@(ViewBag.Sort == "latest")">최신 등록순</option>
            <option value="name" selected="@(ViewBag.Sort == "name")">이름순</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">적용</button>
        <a asp-action="Index" class="btn btn-outline-secondary">초기화</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">등록된 자산이 없습니다. 「자산 등록」으로 추가하세요.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>번호</th>
                <th>이름</th>
                <th>시리얼</th>
                <th>등록일</th>
                <th style="width: 9rem;">관리</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>@asset.Id</td>
                    <td>@asset.Name</td>
                    <td>@(asset.SerialNumber ?? "-")</td>
                    <td>@asset.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@asset.Id">수정</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@asset.Id">삭제</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}